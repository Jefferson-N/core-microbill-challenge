# ===========================================
# MICROBILL - CONFIGURACIÓN DE EJEMPLO
# ===========================================

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=microbill_billing
DB_USER=appuser
DB_PASSWORD=appuser123
DB_ROOT_PASSWORD=root123

# JWT Configuration (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=yMgG5oRTgVEdY5usxFodl762V7PRLxyTlVMkQTKBEhWKsGbWUjsxJaALCSwr3qKr
JWT_EXPIRATION=86400000

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# Microservices Ports
AUTH_SERVICE_PORT=8081
MANAGEMENT_SERVICE_PORT=8082
BILLING_SERVICE_PORT=8083
AI_SERVICE_PORT=8084
FRONTEND_PORT=4200

# Service URLs (Internal Docker Network)
AUTH_SERVICE_URL=http://auth-service:8081
MANAGEMENT_SERVICE_URL=http://management-service:8082
BILLING_SERVICE_URL=http://billing-service:8083
AI_SERVICE_URL=http://ai-service:8084

# Service URLs (Local Development)
AUTH_SERVICE_LOCAL_URL=http://localhost:8081
MANAGEMENT_SERVICE_LOCAL_URL=http://localhost:8082
BILLING_SERVICE_LOCAL_URL=http://localhost:8083
AI_SERVICE_LOCAL_URL=http://localhost:8084

# Security Configuration
SECURITY_PUBLIC_ENDPOINTS=/swagger-ui/**,/api-docs/**,/actuator/**,/api/health,/internal/**,/api/auth/**,/v3/api-docs/**

# Internal Service Communication
SERVICE_TO_SERVICE_ENABLED=true

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Spring Configuration
SPRING_PROFILES_ACTIVE=docker
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_CORE_MICROBILL=DEBUG

# Application Version
APP_VERSION=1.0.0