# ===========================================
# MICROBILL - CONFIGURACIÓN DE EJEMPLO
# ===========================================
# Copie este archivo como .env y ajuste los valores según su entorno

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=microbill_db
DB_USER=microbill_user
DB_PASSWORD=your_secure_password_here
DB_ROOT_PASSWORD=your_root_password_here

# JWT Configuration (CAMBIAR EN PRODUCCIÓN)
JWT_SECRET=your-jwt-secret-key-minimum-256-bits-change-in-production
JWT_EXPIRATION=86400000

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password

# Microservices Ports
AUTH_SERVICE_PORT=8079
MANAGEMENT_SERVICE_PORT=8081
BILLING_SERVICE_PORT=8080
AI_SERVICE_PORT=8082
FRONTEND_PORT=4200

# Environment (dev, test, prod, docker)
SPRING_PROFILES_ACTIVE=docker

# Application Version
APP_VERSION=1.0.0