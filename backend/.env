# Database Configuration
DB_HOST=localhost
DB_PORT_AUTH=3306
DB_PORT=3306
DB_PORT_MANAGEMENT=3306
DB_PORT_BILLING=3306
DB_NAME_AUTH=microservices_db
DB_NAME_MANAGEMENT=microservices_db
DB_NAME_BILLING=microservices_db

DB_USER=admin
DB_PASSWORD=admin123
DB_NAME=microservices_db

# JWT Configuration
JWT_SECRET=microbill-secret-key-change-in-production-2024-minimum-256-bits
JWT_EXPIRATION=86400000

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8084

# Auth Service Configuration
AUTH_SERVICE_URL=http://localhost:8081

# Server Ports
AUTH_SERVICE_PORT=8081
MANAGEMENT_SERVICE_PORT=8082
BILLING_SERVICE_PORT=8083
AI_SERVICE_PORT=8084

# Environment
SPRING_PROFILES_ACTIVE=dev
